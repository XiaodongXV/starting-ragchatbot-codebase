# Copy this file to .env and fill in the key for the provider you want to use.

# Which provider to use: anthropic | gemini | openai
LLM_PROVIDER=anthropic

# Only the active provider's key is required.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional — overrides the provider's default model.
# Must be a LiteLLM model name, i.e. prefixed with the provider.
# LLM_MODEL=gemini/gemini-2.0-flash

# Optional — comma-separated models tried in order when the primary fails
# (e.g. free-tier daily quota exhausted, or a 503 overload).
# LLM_FALLBACK_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-2.5-flash
